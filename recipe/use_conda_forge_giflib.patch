Link conda-forge's giflib instead of the vendored copy.

Upstream vendors a decode-only subset of GIFLIB 5.2.2 under
src/torchcodec/_core/giflib/ and compiles it statically into
libtorchcodec_image. conda-forge packages giflib separately, so build against
that instead: this keeps a single copy of the codec in the distribution (and
keeps its MIT license attached to the giflib package rather than to
torchcodec).

CMake's own FindGIF module provides the GIF::GIF target. The decode-side API
DecodeGif.cpp uses (DGifOpen/DGifSlurp/DGifSavedExtensionToGCB/DGifCloseFile
and the GifFileType/SavedImage/GraphicsControlBlock structs) is unchanged
between the vendored 5.2.2 and conda-forge's giflib 6.1.3.

The vendored directory itself is deleted by the build script.

diff --git a/src/torchcodec/_core/CMakeLists.txt b/src/torchcodec/_core/CMakeLists.txt
index 1bcb5f8..61ff9a3 100644
--- a/src/torchcodec/_core/CMakeLists.txt
+++ b/src/torchcodec/_core/CMakeLists.txt
@@ -148,7 +148,23 @@ function(discover_image_codecs)
 
     resolve_image_codec("${TORCHCODEC_BUILD_GIF}" want_gif)
     if(want_gif)
-        message(STATUS "Building torchcodec with GIF image decoding support (vendored giflib).")
+        if(NOT DEFINED GIF_ROOT AND DEFINED ENV{CONDA_PREFIX})
+            if(WIN32)
+                set(GIF_ROOT "$ENV{CONDA_PREFIX}/Library")
+            else()
+                set(GIF_ROOT "$ENV{CONDA_PREFIX}")
+            endif()
+        endif()
+        find_package(GIF)  # Provides the GIF::GIF target.
+        if(GIF_FOUND)
+            message(STATUS "giflib found: building torchcodec with GIF image decoding support.")
+        else()
+            message(FATAL_ERROR
+                "giflib not found, but GIF image decoding is enabled. Install "
+                "giflib and its development headers, or set TORCHCODEC_BUILD_GIF=0 "
+                "to build without GIF support (decode_gif will raise at runtime), "
+                "or TORCHCODEC_BUILD_IMAGE=0 to disable all image decoders.")
+        endif()
     else()
         message(STATUS "Not building torchcodec with GIF image decoding support (disabled via TORCHCODEC_BUILD_GIF/TORCHCODEC_BUILD_IMAGE): decode_gif will raise at runtime.")
     endif()
@@ -482,9 +498,6 @@ function(make_torchcodec_image_library)
         ${TORCHCODEC_IMAGE_OPS_SOURCES}
         ${TORCHCODEC_IO_SOURCES}
     )
-    if(want_gif)
-        list(APPEND image_library_sources ${TORCHCODEC_GIFLIB_SOURCES})
-    endif()
 
     make_torchcodec_sublibrary(
         "${image_library_name}"
@@ -523,11 +536,11 @@ function(make_torchcodec_image_library)
     endif()
     if(want_gif)
         target_compile_definitions(${image_library_name} PRIVATE TORCHCODEC_ENABLE_GIF=1)
+        target_link_libraries(${image_library_name} PRIVATE GIF::GIF)
     endif()
 
-    # Hide our own (and statically linked giflib's) symbols so the only thing
-    # exported is the torch op registration. Belt-and-suspenders on top of the
-    # RTLD_LOCAL isolation.
+    # Hide our own symbols so the only thing exported is the torch op
+    # registration. Belt-and-suspenders on top of the RTLD_LOCAL isolation.
     if(LINUX)
         target_compile_options(${image_library_name} PRIVATE "-fvisibility=hidden")
     endif()
